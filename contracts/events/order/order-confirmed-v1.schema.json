{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:loopers:contracts:events:order:order-confirmed:v1",
  "title": "OrderConfirmed v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventType",
    "schemaVersion",
    "eventId",
    "orderId",
    "confirmedAt",
    "items"
  ],
  "properties": {
    "eventType": {
      "const": "OrderConfirmed"
    },
    "schemaVersion": {
      "const": 1
    },
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "orderId": {
      "type": "integer",
      "minimum": 1
    },
    "confirmedAt": {
      "type": "string",
      "format": "date-time"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "productId",
          "quantity"
        ],
        "properties": {
          "productId": {
            "type": "integer",
            "minimum": 1
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
