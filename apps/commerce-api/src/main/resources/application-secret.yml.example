# PG 테스트 키 견본. 이 파일을 같은 폴더에 application-secret.yml 로 복사한 뒤 값을 채운다.
# application-secret.yml 은 .gitignore 대상이라 커밋되지 않는다. 이 견본에는 값을 넣지 않는다.
# 테스트(샌드박스) 키만 쓴다. live 키는 넣지 않는다.

pg:
  toss:
    # 토스페이먼츠 개발자센터 > API 키 (test_ck_… / test_sk_…)
    client-key:
    secret-key:
  portone:
    # V2 — PortOne 콘솔 > 결제 연동 > 연동 정보
    store-id:
    channel-key:
    api-secret:
    webhook-secret:
    # V1(iamport) 키를 받았다면 아래를 채운다
    v1:
      imp-code:
      api-key:
      api-secret:
      provider: # 결제창 pg 값. 예: html5_inicis.{상점ID}, tosspayments
