{
  "change": "Step 5: Redis cache-aside on the customer product list (version keys, after-commit invalidation, active-product check on hit, Redis fallback); no cache warm-up",
  "code": "commit e0f923f (cache commits 19e1a7f, 5e9bacb, 68e2c1b; JPQL like count e0f923f)",
  "tool": "k6 1.6.1",
  "measured_samples_per_run": 1000,
  "warmup_requests_per_vu": 3,
  "no_connection_reuse": true,
  "method": {
    "redis": "dedicated redis:7.0 container on port 16380 for measurement only; the shared local redis containers were not used",
    "app": "bootJar of e0f923f, local profile, server 18081, management 18082, show-sql off, Redis master/replica pointed to the measurement container",
    "run_1_order": "app start -> one request to fill the cache -> hit 1/10/100 VU -> FLUSHALL + cold 100 VU x3 -> fill -> sustained hit 100 VU x 50,000",
    "run_2_order": "app restart -> FLUSHALL -> evictor on -> miss 1/10/100 VU -> evictor off -> fill -> mixed like toggles 5/s and 25/s with 100 VU x 50,000 reads",
    "miss": "evict_on_set.py subscribes to keyevent set notifications on the measurement Redis and deletes product:list:v1:* keys right after they are stored; sequential requests always miss, concurrent requests can hit between SET and DEL",
    "mixed": "k6 like_writes scenario: each iteration one user (200 users who had not liked product 908106) adds then cancels a like on product 908106, which is in brand 7 but outside the measured page; 2 invalidations per iteration; reads are still checked against the canonical response",
    "hit_ratio": "misses = product page query calls from performance_schema digests; hit ratio = 1 - misses / read requests including warmup",
    "hikari": "hikaricp acquire/usage timers from actuator prometheus before and after each run",
    "like_state": "likes on product 908106: 1 before and 1 after"
  },
  "discarded_runs": [
    "first miss 1/10 VU: cache key from earlier runs remained and evictor only deletes on new SET -> all hits; rerun after FLUSHALL",
    "first mixed runs: one user alternated add/cancel concurrently -> duplicate-key 500s on like writes (existing like behavior under concurrent duplicate requests, unrelated to cache); rerun with per-iteration users"
  ],
