    {
      "id": 20,
      "type": "table",
      "title": "최근 확정 주문의 상품별 수량",
      "description": "최근 결제 확정된 혼합 장바구니 여섯 건을 상품별로 펼쳐 본다. 한 주문번호가 여러 행이면 다품목 구매다.",
      "gridPos": {
        "x": 12,
        "y": 46,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "mysql",
        "uid": "w10-mysql"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "w10-mysql"
          },
          "rawSql": "WITH recent AS (\n  SELECT order_id, confirmed_at FROM w10_catalog_mixed_orders WHERE $__timeFilter(confirmed_at) ORDER BY confirmed_at DESC,order_id DESC LIMIT 6\n)\nSELECT l.order_id AS `주문번호`,p.product_name AS `구매 상품`,l.product_id AS `상품 ID`,l.quantity AS `수량`\nFROM recent r JOIN w10_catalog_mixed_lines l ON l.order_id=r.order_id\nLEFT JOIN w10_catalog_products p ON p.product_id=l.product_id\nORDER BY r.confirmed_at DESC,r.order_id DESC,l.product_id",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
