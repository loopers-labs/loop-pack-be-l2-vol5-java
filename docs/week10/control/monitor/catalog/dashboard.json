    {
      "id": 5,
      "type": "table",
      "title": "구간별 물 주문 30초 내 확정률",
      "description": "접수는 해당 1분 동안 서버가 처음 수락한 물 주문 수다. ‘30초 경과분 확정률’은 이미 30초를 관찰한 주문만 계산한다. ‘최종 확정률’은 구간 종료 30초 뒤 전체 접수 중 30초 이내 확정된 비율이다. 아직 계산할 수 없거나 분모가 0이면 —. 다시보기에서는 선택한 종료 시각 기준으로 표시한다.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 5
      },
      "datasource": {
        "type": "mysql",
        "uid": "w10-mysql"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "w10-mysql"
          },
          "rawSql": "WITH horizon AS (\n  SELECT LEAST(UTC_TIMESTAMP(6), FROM_UNIXTIME($__unixEpochTo())) AS as_of\n), amounts AS (\n  SELECT p.phase, p.starts_at, p.ends_at, h.as_of,\n         COUNT(w.order_id) AS accepted,\n         COUNT(CASE WHEN w.accepted_at <= h.as_of - INTERVAL 30 SECOND THEN 1 END) AS matured,\n         COUNT(CASE WHEN w.within_30s = 1 AND w.confirmed_at <= h.as_of THEN 1 END) AS on_time,\n         COUNT(CASE WHEN w.within_30s = 1 AND w.accepted_at <= h.as_of - INTERVAL 30 SECOND THEN 1 END) AS matured_on_time\n  FROM w10_control_phases p CROSS JOIN horizon h\n  LEFT JOIN w10_control_water_orders w ON w.accepted_at >= p.starts_at AND w.accepted_at < p.ends_at AND w.accepted_at <= h.as_of\n  GROUP BY p.phase, p.starts_at, p.ends_at, h.as_of\n)\nSELECT n.label AS `측정 구간`,\n       CASE WHEN a.starts_at IS NULL OR a.as_of < a.starts_at THEN '대기'\n            WHEN a.as_of < a.ends_at THEN '접수 중'\n            WHEN a.as_of < a.ends_at + INTERVAL 30 SECOND THEN '마지막 주문 판정 중'\n            WHEN a.accepted = 0 THEN '접수 없음' ELSE '집계 완료' END AS `상태`,\n       DATE_FORMAT(a.starts_at + INTERVAL 9 HOUR,'%H:%i:%s') AS `시작 (KST)`,\n       a.accepted AS `접수`, a.matured AS `30초 경과`, a.on_time AS `30초 내 확정`,\n       100.0 * a.matured_on_time / NULLIF(a.matured,0) AS `30초 경과분 확정률`,\n       CASE WHEN a.as_of >= a.ends_at + INTERVAL 30 SECOND\n            THEN 100.0 * a.on_time / NULLIF(a.accepted,0) END AS `최종 확정률`\nFROM (SELECT 'normal' AS phase, '정상' AS label, 1 AS seq\n      UNION ALL SELECT 'comparison','장애 대응 시간대 · 대조',2\n      UNION ALL SELECT 'recovery','복구 대응 시간대 · 대조',3) n\nLEFT JOIN amounts a ON a.phase = n.phase ORDER BY n.seq",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "noValue": "—"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/확정률$/"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "측정 구간"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 180
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "상태"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": []
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "가장 많이 본 상품 10개",
      "description": "선택한 기간에 성공한 상세 조회 횟수 순. 같은 사용자의 다시 보기도 한 번으로 센다.",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "mysql",
        "uid": "w10-mysql"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "w10-mysql"
          },
          "rawSql": "WITH top_products AS (\n  SELECT product_id, SUM(hits-errors) AS views, SUM(CASE WHEN kind='revisit' THEN hits-errors ELSE 0 END) AS revisits\n  FROM w10_catalog_reads WHERE $__timeFilter(bucket_at)\n  GROUP BY product_id HAVING views > 0 ORDER BY views DESC, product_id LIMIT 10\n)\nSELECT ROW_NUMBER() OVER (ORDER BY t.views DESC,t.product_id) AS `순위`, p.product_name AS `상품`,\n       t.product_id AS `상품 ID`, t.views AS `상세 조회`, t.revisits AS `다시 보기`\nFROM top_products t JOIN w10_catalog_products p ON p.product_id=t.product_id ORDER BY t.views DESC,t.product_id",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "noValue": "—"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "순위"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 52
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "상품 ID"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 77
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "상세 조회"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 83
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "다시 보기"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 83
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "카테고리별 상세 조회와 구매",
      "description": "조회는 성공한 상세 요청, 구매는 서버에서 결제가 확정된 주문이다. 한 주문에 두 카테고리의 상품이 있으면 양쪽에 한 번씩 포함한다.",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "mysql",
        "uid": "w10-mysql"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "w10-mysql"
          },
          "rawSql": "WITH seen AS (\n  SELECT p.category,SUM(r.hits-r.errors) AS views FROM w10_catalog_reads r JOIN w10_catalog_products p ON p.product_id=r.product_id\n  WHERE $__timeFilter(r.bucket_at) GROUP BY p.category\n), bought AS (\n  SELECT category,COUNT(DISTINCT order_id) AS orders,SUM(quantity) AS units FROM w10_catalog_mixed_lines\n  WHERE $__timeFilter(confirmed_at) GROUP BY category\n)\nSELECT c.category AS `카테고리`,COALESCE(s.views,0) AS `상세 조회`,COALESCE(b.orders,0) AS `확정 주문`,COALESCE(b.units,0) AS `구매 수량`\nFROM (SELECT DISTINCT category FROM w10_catalog_products) c LEFT JOIN seen s ON s.category=c.category\nLEFT JOIN bought b ON b.category=c.category ORDER BY COALESCE(s.views,0) DESC,c.category",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "noValue": "—"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "탐색과 결제 · 실제 건수",
      "description": "탐색은 상품 목록·브랜드 필터·상세·다시 보기 HTTP 호출 수. 구매는 독립된 혼합 구매자 그룹에서 실제로 접수·확정한 주문이다.",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "mysql",
        "uid": "w10-mysql"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "w10-mysql"
          },
          "rawSql": "WITH visits AS (\n  SELECT COALESCE((SELECT product_requests FROM w10_control_samples WHERE sampled_at<=FROM_UNIXTIME($__unixEpochTo()) ORDER BY sampled_at DESC LIMIT 1),0)\n       - COALESCE((SELECT product_requests FROM w10_control_samples WHERE sampled_at<FROM_UNIXTIME($__unixEpochFrom()) ORDER BY sampled_at DESC LIMIT 1),0) AS n)\nSELECT n AS `탐색 GET`,(SELECT COUNT(*) FROM w10_catalog_mixed_orders WHERE $__timeFilter(accepted_at)) AS `결제 접수`,\n       (SELECT COUNT(*) FROM w10_catalog_mixed_orders WHERE $__timeFilter(confirmed_at)) AS `결제 확정`,\n       (SELECT COALESCE(SUM(units),0) FROM w10_catalog_mixed_orders WHERE $__timeFilter(confirmed_at)) AS `구매 수량` FROM visits",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "noValue": "—"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "최근 확정 주문 · 품목과 수량",
      "description": "품목 수는 서로 다른 상품의 개수, 총 수량은 주문 안에 포함된 개수의 합계다. 혼합 구매 사용자의 실제 확정 주문을 표시한다.",
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "mysql",
        "uid": "w10-mysql"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "w10-mysql"
          },
          "rawSql": "SELECT order_id AS `주문번호`,sku_count AS `품목 수`,units AS `총 수량`,DATE_FORMAT(confirmed_at+INTERVAL 9 HOUR,'%H:%i:%s') AS `확정 (KST)`\nFROM w10_catalog_mixed_orders WHERE $__timeFilter(confirmed_at) ORDER BY confirmed_at DESC,order_id DESC LIMIT 12",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
