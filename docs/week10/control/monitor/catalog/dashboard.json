    {
      "id": 4,
      "type": "stat",
      "title": "물 주문 · 30초 내 확정률",
      "description": "선택한 기간에 접수되어 종료 시점까지 30초 이상 관찰한 물 주문의 확정률. 구간별 최종 결과는 아래 표에 표시한다.",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "mysql",
        "uid": "w10-mysql"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "w10-mysql"
          },
          "rawSql": "SELECT 100.0*SUM(within_30s)/NULLIF(COUNT(*),0) AS `확정률` FROM w10_control_water_orders WHERE $__timeFilter(accepted_at) AND accepted_at<=LEAST(UTC_TIMESTAMP(6),FROM_UNIXTIME($__unixEpochTo())) - INTERVAL 30 SECOND",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
