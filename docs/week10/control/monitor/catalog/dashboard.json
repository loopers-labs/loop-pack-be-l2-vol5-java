    {
      "id": 16,
      "type": "stat",
      "title": "물 결제 요청 · 초당",
      "description": "최근 최대 30초의 JMeter 송신 누계 차이를 실제 관측 시간으로 나눈 값. 물 주문 초안 생성 후 PG 결제를 요청한 횟수를 센다. 선택한 종료 시각 직전 약 10초 동안 표본이 없으면 ‘측정 종료·대기’로 표시한다.",
      "gridPos": {
        "x": 12,
        "y": 37,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "mysql",
        "uid": "w10-mysql"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "w10-mysql"
          },
          "rawSql": "WITH last_sample AS (SELECT MAX(sampled_at) AS t FROM w10_control_samples WHERE $__timeFilter(sampled_at) AND sampled_at >= FROM_UNIXTIME($__unixEpochTo()) - INTERVAL 9 SECOND) SELECT (MAX(water_sent)-MIN(water_sent))/NULLIF(TIMESTAMPDIFF(MICROSECOND,MIN(sampled_at),MAX(sampled_at))/1000000.0,0) AS `송신/초` FROM w10_control_samples JOIN last_sample ON sampled_at BETWEEN t - INTERVAL 30 SECOND AND t",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "min": 0,
          "noValue": "측정 종료·대기",
          "color": {
            "mode": "fixed",
            "fixedColor": "light-blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "last"
          ],
          "fields": ""
        },
        "orientation": "horizontal",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 17,
      "type": "table",
      "title": "물 주문 · 송신, 접수, 30초 내 확정",
      "description": "물 전용 사용자·상품의 결제 요청, 서버 접수, 30초 내 확정 건수. 준비 구간과 측정 구간 사이의 주문도 포함한다.",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "mysql",
        "uid": "w10-mysql"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "w10-mysql"
          },
          "rawSql": "WITH horizon AS (SELECT LEAST(UTC_TIMESTAMP(6), FROM_UNIXTIME($__unixEpochTo())) AS t)\nSELECT (SELECT s.water_sent FROM w10_control_samples s WHERE s.sampled_at <= h.t ORDER BY s.sampled_at DESC LIMIT 1) AS `JMeter 결제 요청 누계`,\n       COUNT(w.order_id) AS `서버 접수`,\n       COUNT(CASE WHEN w.within_30s = 1 AND w.confirmed_at <= h.t THEN 1 END) AS `30초 내 확정`\nFROM horizon h LEFT JOIN w10_control_water_orders w ON w.accepted_at <= h.t\nGROUP BY h.t",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "noValue": "—"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
