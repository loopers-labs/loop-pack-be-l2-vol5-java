    {
      "id": 2,
      "type": "stat",
      "title": "상품 상세 조회 · 초당",
      "description": "최근 30초간 JMeter에서 성공한 상세 조회와 다시 보기. 5초마다 실제 요청을 반영한다.",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "mysql",
        "uid": "w10-mysql"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "w10-mysql"
          },
          "rawSql": "SELECT SUM(hits-errors)/30.0 AS `상세 조회/초` FROM w10_catalog_reads WHERE bucket_at > LEAST(UTC_TIMESTAMP(6),FROM_UNIXTIME($__unixEpochTo())) - INTERVAL 30 SECOND AND bucket_at <= LEAST(UTC_TIMESTAMP(6),FROM_UNIXTIME($__unixEpochTo()))",
