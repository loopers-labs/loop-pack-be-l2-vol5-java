    {
      "id": 13,
      "type": "timeseries",
      "title": "탐색 오류율",
      "description": "서버의 상품 API 5xx와 JMeter의 전체 탐색 오류 비율. 요청이 없는 구간은 비운다.",
      "gridPos": {
        "x": 12,
        "y": 31,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "w10-prom"
          },
          "expr": "100*((sum(rate(http_server_requests_seconds_count{job=\"commerce-control\",method=\"GET\",uri=~\"/api/v1/products.*\",status=~\"5..\"}[30s]))) or (0 * (sum(rate(http_server_requests_seconds_count{job=\"commerce-control\",method=\"GET\",uri=\"/api/v1/products\"}[30s])) + sum(rate(http_server_requests_seconds_count{job=\"commerce-control\",method=\"GET\",uri=\"/api/v1/products/{productId}\"}[30s]))))) / ((sum(rate(http_server_requests_seconds_count{job=\"commerce-control\",method=\"GET\",uri=\"/api/v1/products\"}[30s])) + sum(rate(http_server_requests_seconds_count{job=\"commerce-control\",method=\"GET\",uri=\"/api/v1/products/{productId}\"}[30s]))) > 0)",
          "legendFormat": "서버 5xx",
          "instant": false,
          "range": true,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "mysql",
            "uid": "w10-mysql"
          },
          "rawSql": "WITH d AS (SELECT sampled_at, product_requests, product_errors, LAG(sampled_at) OVER (ORDER BY sampled_at) AS prev_at, LAG(product_requests) OVER (ORDER BY sampled_at) AS prev_requests, LAG(product_errors) OVER (ORDER BY sampled_at) AS prev_errors FROM w10_control_samples WHERE $__timeFilter(sampled_at)) SELECT sampled_at AS time, 100.0*(product_errors-prev_errors)/NULLIF(product_requests-prev_requests,0) AS `JMeter 오류` FROM d WHERE prev_at IS NOT NULL ORDER BY time",
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "noValue": "대기"
        },
        "overrides": []
