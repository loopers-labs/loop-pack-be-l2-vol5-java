    {
      "id": 7,
      "type": "timeseries",
      "title": "상품 목록 조회 처리량",
      "description": "서버에서 끝난 GET 요청과 부하 발생기에서 완료된 조회를 초당 건수로 비교한다. Prometheus는 최근 30초 평균, JMeter는 직전 표본 대비 값이다.",
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "w10-prom"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"commerce-control\",method=\"GET\",uri=\"/api/v1/products\"}[30s]))",
          "legendFormat": "서버 · GET/초",
          "instant": false,
          "range": true,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "mysql",
            "uid": "w10-mysql"
          },
          "rawSql": "WITH d AS (SELECT sampled_at, product_requests, product_errors, LAG(sampled_at) OVER (ORDER BY sampled_at) AS prev_at, LAG(product_requests) OVER (ORDER BY sampled_at) AS prev_requests, LAG(product_errors) OVER (ORDER BY sampled_at) AS prev_errors FROM w10_control_samples WHERE $__timeFilter(sampled_at)) SELECT sampled_at AS time, (product_requests-prev_requests)/NULLIF(TIMESTAMPDIFF(MICROSECOND,prev_at,sampled_at)/1000000.0,0) AS `JMeter · 조회/초` FROM d WHERE prev_at IS NOT NULL ORDER BY time",
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "min": 0,
          "noValue": "대기"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
