      "type": "stat",
      "title": "물 결제 요청 · 초당",
      "description": "최근 최대 30초의 JMeter 송신 누계 차이를 실제 관측 시간으로 나눈 값. 물 주문 초안 생성 후 PG 결제를 요청한 횟수를 센다.",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "mysql",
        "uid": "w10-mysql"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "w10-mysql"
          },
          "rawSql": "WITH last_sample AS (SELECT MAX(sampled_at) AS t FROM w10_control_samples WHERE $__timeFilter(sampled_at)) SELECT (MAX(water_sent)-MIN(water_sent))/NULLIF(TIMESTAMPDIFF(MICROSECOND,MIN(sampled_at),MAX(sampled_at))/1000000.0,0) AS `송신/초` FROM w10_control_samples JOIN last_sample ON sampled_at BETWEEN t - INTERVAL 30 SECOND AND t",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
