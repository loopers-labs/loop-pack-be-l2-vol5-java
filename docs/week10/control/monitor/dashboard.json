    {
      "id": 5,
      "type": "table",
      "title": "구간별 물 주문 30초 내 결제 확정률",
      "description": "접수는 해당 1분 동안 서버가 처음 수락한 물 주문 수다. ‘30초 경과분 확정률’은 이미 30초를 관찰한 주문만 계산한다. ‘최종 확정률’은 구간 종료 30초 뒤 전체 접수 중 30초 이내 확정된 비율이다. 아직 계산할 수 없거나 분모가 0이면 —. 다시보기에서는 선택한 종료 시각 기준으로 표시한다.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "mysql",
        "uid": "w10-mysql"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "w10-mysql"
          },
          "rawSql": "WITH horizon AS (\n  SELECT LEAST(UTC_TIMESTAMP(6), FROM_UNIXTIME($__unixEpochTo())) AS as_of\n), amounts AS (\n  SELECT p.phase, p.starts_at, p.ends_at, h.as_of,\n         COUNT(w.order_id) AS accepted,\n         COUNT(CASE WHEN w.accepted_at <= h.as_of - INTERVAL 30 SECOND THEN 1 END) AS matured,\n         COUNT(CASE WHEN w.within_30s = 1 AND w.confirmed_at <= h.as_of THEN 1 END) AS on_time,\n         COUNT(CASE WHEN w.within_30s = 1 AND w.accepted_at <= h.as_of - INTERVAL 30 SECOND THEN 1 END) AS matured_on_time\n  FROM w10_control_phases p CROSS JOIN horizon h\n  LEFT JOIN w10_control_water_orders w ON w.accepted_at >= p.starts_at AND w.accepted_at < p.ends_at AND w.accepted_at <= h.as_of\n  GROUP BY p.phase, p.starts_at, p.ends_at, h.as_of\n)\nSELECT n.label AS `측정 구간`,\n       CASE WHEN a.starts_at IS NULL OR a.as_of < a.starts_at THEN '대기'\n            WHEN a.as_of < a.ends_at THEN '접수 중'\n            WHEN a.as_of < a.ends_at + INTERVAL 30 SECOND THEN '마지막 주문 판정 중'\n            WHEN a.accepted = 0 THEN '접수 없음' ELSE '집계 완료' END AS `상태`,\n       DATE_FORMAT(a.starts_at + INTERVAL 9 HOUR,'%H:%i:%s') AS `시작 (KST)`,\n       a.accepted AS `접수`, a.matured AS `30초 경과`, a.on_time AS `30초 내 확정`,\n       100.0 * a.matured_on_time / NULLIF(a.matured,0) AS `30초 경과분 확정률`,\n       CASE WHEN a.as_of >= a.ends_at + INTERVAL 30 SECOND\n            THEN 100.0 * a.on_time / NULLIF(a.accepted,0) END AS `최종 확정률`\nFROM (SELECT 'normal' AS phase, '정상' AS label, 1 AS seq\n      UNION ALL SELECT 'comparison','장애 대응 시간대 · 대조',2\n      UNION ALL SELECT 'recovery','복구 대응 시간대 · 대조',3) n\nLEFT JOIN amounts a ON a.phase = n.phase ORDER BY n.seq",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "noValue": "—"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/확정률$/"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "측정 구간"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 180
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "상태"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": []
      }
    },
