    "0714d6269d01b006" : "select count(p1_0.id) from product p1_0 join brand b1_0 on b1_0.id=p1_0.brand_id where p1_0.deleted_at is null and b1_0.deleted_at is null",
    "5d974ea1e7de0793" : "select p1_0.id,count(pl1_0.id) from product p1_0 join brand b1_0 on b1_0.id=p1_0.brand_id left join `like` pl1_0 on pl1_0.product_id=p1_0.id where p1_0.deleted_at is null and b1_0.deleted_at is null group by p1_0.id order by count(pl1_0.id) desc,p1_0.id desc limit ?,?",
