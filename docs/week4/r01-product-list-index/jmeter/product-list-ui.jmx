<?xml version="1.0" encoding="utf-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="R01 live UI: warm-up then measurement" enabled="true">
      <stringProp name="TestPlan.comments">Edit User Defined Variables before pressing Start: scenario=latest|price|brand7, threads=1 or 10,
rampup=5 seconds, warmup=20 seconds, duration=60 seconds. No requests run just by opening this file.
Thread groups run sequentially: Warm-up writes only its separate JTL; Measurement alone updates Aggregate Report.
Each duration includes its ramp-up. In-flight requests may finish after the scheduled duration.
HTTP and light correctness checks match the CLI plan; response timeout remains 30000 ms.
JTL files are set by -JguiWarmupFile=PATH and -JguiResultFile=PATH. No response bodies or headers are stored.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments">
          <elementProp name="scenario" elementType="Argument">
            <stringProp name="Argument.name">scenario</stringProp>
            <stringProp name="Argument.value">latest</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="threads" elementType="Argument">
            <stringProp name="Argument.name">threads</stringProp>
            <stringProp name="Argument.value">1</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="rampup" elementType="Argument">
            <stringProp name="Argument.name">rampup</stringProp>
            <stringProp name="Argument.value">5</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="warmup" elementType="Argument">
            <stringProp name="Argument.name">warmup</stringProp>
            <stringProp name="Argument.value">20</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="duration" elementType="Argument">
            <stringProp name="Argument.name">duration</stringProp>
            <stringProp name="Argument.value">60</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="01 Warm-up (separate JTL)" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">-1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${threads}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${rampup}</stringProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.duration">${warmup}</stringProp>
        <stringProp name="ThreadGroup.delay">0</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
      </ThreadGroup>
      <hashTree>
        <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Accept JSON" enabled="true">
          <collectionProp name="HeaderManager.headers">
            <elementProp name="Accept" elementType="Header">
              <stringProp name="Header.name">Accept</stringProp>
              <stringProp name="Header.value">application/json</stringProp>
            </elementProp>
          </collectionProp>
        </HeaderManager>
        <hashTree />
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="products-${scenario}" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="HTTP arguments">
            <collectionProp name="Arguments.arguments" />
          </elementProp>
          <stringProp name="HTTPSampler.domain">${__P(host,localhost)}</stringProp>
          <stringProp name="HTTPSampler.port">${__P(port,18080)}</stringProp>
          <stringProp name="HTTPSampler.protocol">${__P(protocol,http)}</stringProp>
          <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
          <stringProp name="HTTPSampler.path">${requestPath}</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
          <stringProp name="HTTPSampler.implementation">HttpClient4</stringProp>
          <stringProp name="HTTPSampler.connect_timeout">${__P(connectTimeout,3000)}</stringProp>
          <stringProp name="HTTPSampler.response_timeout">${__P(responseTimeout,30000)}</stringProp>
        </HTTPSamplerProxy>
        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Select UI scenario once per thread" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters" />
            <stringProp name="filename" />
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script"><![CDATA[
if (vars.get('requestPath') != null) {
    return
}
try {
    def paths = [
        latest: '/api/v1/products?sort=latest&page=0&size=20',
        price: '/api/v1/products?sort=price_asc&page=0&size=20',
        brand7: '/api/v1/products?brandId=7&sort=price_asc&page=0&size=20'
    ]
    String scenario = vars.get('scenario')
    if (!paths.containsKey(scenario)) {
        throw new IllegalArgumentException('scenario must be latest, price, or brand7')
    }
    vars.put('validation', 'light')
    vars.put('requestPath', paths[scenario])
} catch (Exception error) {
    log.error('Invalid UI benchmark scenario; stopping this thread before HTTP', error)
    ctx.getThread().stop()
    throw error
}
]]></stringProp>
          </JSR223PreProcessor>
          <hashTree />
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="HTTP and JSON contract (full smoke or light load)" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters" />
            <stringProp name="filename" />
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script"><![CDATA[
import groovy.json.JsonSlurper
import org.apache.jmeter.services.FileServer

try {
    if (prev.getResponseCode() != '200') {
        throw new IllegalStateException('Expected HTTP 200, received ' + prev.getResponseCode())
    }
    def actual = new JsonSlurper().parseText(prev.getResponseDataAsString())
    if (actual.meta?.result != 'SUCCESS') {
        throw new IllegalStateException('Expected meta.result=SUCCESS')
    }
    if (!(actual.data?.items instanceof List) || actual.data.items.size() != 20 || actual.data.size != 20) {
        throw new IllegalStateException('Expected data.size=20 and exactly 20 items')
    }
    if (vars.get('validation') == 'light') {
        return
    }
    def fixture = vars.getObject('expectedResponseFixture')
    if (fixture == null) {
        File expectedFile = new File(props.getProperty('expectedFile', 'expected-responses.json'))
        if (!expectedFile.isAbsolute()) {
            expectedFile = new File(FileServer.getFileServer().getBaseDir(), expectedFile.getPath())
        }
        if (!expectedFile.isFile()) {
            throw new IllegalStateException('Expected response JSON not found: ' + expectedFile.getAbsolutePath())
        }
        fixture = new JsonSlurper().parse(expectedFile, 'UTF-8')
        vars.putObject('expectedResponseFixture', fixture)
    }
    def selected = fixture.scenarios[vars.get('scenario')]
    if (selected == null || selected.requestPath != vars.get('requestPath')) {
        throw new IllegalStateException('Expected JSON scenario/path does not match this request')
    }
    def expected = selected.response
    if (actual.keySet() != expected.keySet() || actual.meta != expected.meta) {
        throw new IllegalStateException('Response envelope/meta differs from the expected contract')
    }
    if (actual.data.keySet() != expected.data.keySet()) {
        throw new IllegalStateException('Response page fields differ from the expected contract')
    }
    for (String field : ['page', 'size', 'totalElements', 'totalPages']) {
        if (actual.data[field] != expected.data[field]) {
            throw new IllegalStateException('data.' + field + ': expected=' + expected.data[field] + ', actual=' + actual.data[field])
        }
    }
    for (int index = 0; index < expected.data.items.size(); index++) {
        if (actual.data.items[index] != expected.data.items[index]) {
            throw new IllegalStateException('data.items[' + index + '] differs: expected='
                + expected.data.items[index] + ', actual=' + actual.data.items[index])
        }
    }
} catch (Exception error) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(error.getMessage())
}
]]></stringProp>
          </JSR223Assertion>
          <hashTree />
        </hashTree>
        <ResultCollector guiclass="SimpleDataWriter" testclass="ResultCollector" testname="Warm-up JTL only" enabled="true">
          <boolProp name="ResultCollector.error_logging">false</boolProp>
          <objProp>
            <name>saveConfig</name>
            <value class="SampleSaveConfiguration">
              <time>true</time>
              <latency>true</latency>
              <timestamp>true</timestamp>
              <success>true</success>
              <label>true</label>
              <code>true</code>
              <message>true</message>
              <threadName>true</threadName>
              <dataType>true</dataType>
              <encoding>false</encoding>
              <assertions>false</assertions>
              <subresults>false</subresults>
              <responseData>false</responseData>
              <samplerData>false</samplerData>
              <xml>false</xml>
              <fieldNames>true</fieldNames>
              <responseHeaders>false</responseHeaders>
              <requestHeaders>false</requestHeaders>
              <responseDataOnError>false</responseDataOnError>
              <saveAssertionResultsFailureMessage>true</saveAssertionResultsFailureMessage>
              <assertionsResultsToSave>0</assertionsResultsToSave>
              <bytes>true</bytes>
              <sentBytes>true</sentBytes>
              <url>true</url>
              <threadCounts>true</threadCounts>
              <idleTime>true</idleTime>
              <connectTime>true</connectTime>
            </value>
          </objProp>
          <stringProp name="filename">${__P(guiWarmupFile,)}</stringProp>
        </ResultCollector>
        <hashTree />
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="02 Measurement (Aggregate Report)" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">-1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${threads}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${rampup}</stringProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.duration">${duration}</stringProp>
        <stringProp name="ThreadGroup.delay">0</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
      </ThreadGroup>
      <hashTree>
        <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Accept JSON" enabled="true">
          <collectionProp name="HeaderManager.headers">
            <elementProp name="Accept" elementType="Header">
