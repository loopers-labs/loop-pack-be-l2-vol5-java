{
  "uid": "w10-payment-live",
  "title": "W10 결제 모니터링 · 실시간",
  "description": "commerce-api의 현재 결제 상태, HTTP 응답, DB 풀 및 JVM 지표를 조회합니다. 보존된 W10 실험은 연결된 사고 재생 대시보드에서 확인할 수 있습니다.",
  "tags": [
    "W10",
    "payments",
    "live"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "metrics",
        "query": "prometheus",
        "regex": "/^Prometheus$/",
        "hide": 2,
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "options": [],
        "current": {}
      }
    ]
  },
  "links": [
    {
      "type": "link",
      "title": "W10 사고 재생",
      "url": "/d/w10-payment-incident/",
      "keepTime": false,
      "includeVars": false,
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "미확인 결제 건수",
      "description": "각 인스턴스가 같은 DB의 UNKNOWN 결제 시도를 셉니다. 인스턴스별 값은 합산하지 않습니다. 첫 집계 전이나 집계 실패·오래된 표본은 NaN이므로 0건으로 해석하지 않습니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "editorMode": "code",
          "expr": "commerce_payment_unknown{job=\"spring-boot-app\",application=\"commerce-api\"}",
          "legendFormat": "{{instance}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "custom": {
            "lineInterpolation": "stepAfter",
            "spanNulls": false,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Prometheus 수집 연결",
      "description": "수집 대상별로 1이면 API 지표를 읽었고 0이면 수집에 실패했습니다. 시계열이 없으면 Prometheus의 Targets에서 대상을 확인합니다. 결제 성공 여부는 별도로 확인합니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "editorMode": "code",
          "expr": "up{job=\"spring-boot-app\"}",
          "legendFormat": "{{instance}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "decimals": 0,
          "custom": {
            "lineInterpolation": "stepAfter",
            "spanNulls": false,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "주문 확정 응답 · 상태 코드별 요청률",
      "description": "POST confirm의 초당 요청 수입니다. 202는 결제 확인 중을 뜻합니다. 200·202·5xx 응답을 상태 코드별로 표시합니다. 한 번도 관측되지 않은 코드는 범례에 나타나지 않을 수 있습니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "editorMode": "code",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"spring-boot-app\",application=\"commerce-api\",method=\"POST\",uri=\"/api/v1/orders/{orderId}/confirm\",status=~\"200|202|5..\"}[$__rate_interval]))",
          "legendFormat": "HTTP {{status}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineInterpolation": "linear",
            "spanNulls": false,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "주문 확정 응답 시간 · p95",
      "description": "모든 인스턴스의 POST confirm 히스토그램을 모아 95번째 백분위 응답 시간을 추정합니다. 요청이 없는 구간이나 표본이 부족한 구간은 비어 있을 수 있습니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"spring-boot-app\",application=\"commerce-api\",method=\"POST\",uri=\"/api/v1/orders/{orderId}/confirm\"}[$__rate_interval])))",
          "legendFormat": "confirm p95",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "lineInterpolation": "linear",
            "spanNulls": false,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "DB 연결 대기",
      "description": "풀에서 연결을 빌리려고 기다리는 스레드 수입니다. 주문 응답이 느려진 시간대에 대기가 지속되는지 풀·인스턴스별로 확인합니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "editorMode": "code",
          "expr": "hikaricp_connections_pending{job=\"spring-boot-app\",application=\"commerce-api\"}",
          "legendFormat": "{{pool}} · {{instance}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "custom": {
            "lineInterpolation": "stepAfter",
            "spanNulls": false,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "GC 후 장수 힙 사용률",
      "description": "마지막 GC 뒤 장수 객체 영역의 사용 비율입니다. 비슷한 부하와 여러 GC를 거친 장기 추세에서 회수 후 사용량이 계속 오르는지 확인합니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "editorMode": "code",
          "expr": "100 * jvm_memory_usage_after_gc{job=\"spring-boot-app\",application=\"commerce-api\",area=\"heap\",pool=\"long-lived\"}",
          "legendFormat": "{{instance}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "custom": {
            "lineInterpolation": "stepAfter",
            "spanNulls": false,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
