{
  "uid": "commerce-payment",
  "title": "결제 미확인·에러",
  "schemaVersion": 39,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "미종결 결제 수 (상태별)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "commerce_payment_unresolved", "legendFormat": "{{status}}" } ]
    },
    {
      "id": 2, "type": "timeseries", "title": "가장 오래 기다린 미종결 결제 (초)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [ { "refId": "A", "expr": "commerce_payment_unresolved_oldest_age_seconds", "legendFormat": "{{status}}" } ]
    },
    {
      "id": 3, "type": "timeseries", "title": "ERROR 로그 rate (앱별)",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum by (application) (rate(logback_events_total{level=\"error\"}[1m]))", "legendFormat": "{{application}}" } ]
    }
  ]
}
