  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "결제: 끝났는가 (프로세스가 정상이어도 여기가 어긋날 수 있다)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "지금 결과를 모르는 결제",
      "description": "결과를 모르는 채 남은 결제 수. 상태가 바뀌어 커밋되는 즉시 반영된다. 재시작하면 0 에서 다시 시작하고, 재시작 전에 남은 결제가 닫히면 음수가 된다.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(payment_unresolved{application=\"commerce-api\",status=\"unknown\"})",
          "legendFormat": ""
        }
      ]
    },
