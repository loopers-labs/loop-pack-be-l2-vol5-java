# Local Docker Desktop example. Copy to app.env and fill in ADMIN_PASSWORD.
APP_IMAGE=commerce-api:local
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=18080
METRICS_BIND_ADDRESS=127.0.0.1
METRICS_PORT=18081
MYSQL_HOST=host.docker.internal
MYSQL_PORT=13307
MYSQL_DATABASE=perf_uniform_10k_v1
MYSQL_USER=application
MYSQL_PWD=application
ADMIN_PASSWORD=
REDIS_MASTER_HOST=host.docker.internal
REDIS_MASTER_PORT=6379
REDIS_REPLICA_1_HOST=host.docker.internal
REDIS_REPLICA_1_PORT=6380
JAVA_TOOL_OPTIONS=
